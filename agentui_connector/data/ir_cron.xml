<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_agentui_sync" model="ir.cron">
        <field name="name">AgentUI: sync apps</field>
        <field name="model_id" ref="model_agentui_app"/>
        <field name="state">code</field>
        <field name="code">model._agentui_sync_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <!-- Finishes Connect to AgentUI outside the browser's request (triggered, not scheduled). -->
    <record id="ir_cron_agentui_finish_connect" model="ir.cron">
        <field name="name">AgentUI: finish connection</field>
        <field name="model_id" ref="model_agentui_app"/>
        <field name="state">code</field>
        <field name="code">model._agentui_finish_connect()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
