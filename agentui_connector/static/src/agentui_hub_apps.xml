<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agentui_connector.AppList">
        <section>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <h2 class="o_agentui_section_title mb-0 me-auto">
                    <span>Your apps</span>
                    <span t-if="props.apps.length" class="o_agentui_count ms-2" t-esc="props.apps.length"/>
                </h2>
                <div t-if="showSearch" class="o_agentui_search position-relative">
                    <i class="fa fa-search position-absolute text-muted" aria-hidden="true"/>
                    <input type="search" class="form-control" t-model="state.query"
                           placeholder="Search apps" aria-label="Search apps"/>
                </div>
            </div>

            <div t-if="!props.apps.length" class="o_agentui_empty text-center">
                <i class="fa fa-th-large fa-2x mb-3" aria-hidden="true"/>
                <div class="fw-semibold">No apps yet</div>
                <div class="text-muted small">Pick an idea above or describe your own. Your app shows up here and in the Odoo home menu.</div>
            </div>
            <div t-elif="!visibleApps.length" class="o_agentui_empty text-center text-muted small">
                No apps match your search.
            </div>

            <div class="row g-3">
                <div t-foreach="visibleApps" t-as="app" t-key="app.id" class="col-12 col-sm-6 col-xl-4 position-relative">
                    <div t-if="props.onManage" class="o_agentui_card_menu">
                        <Dropdown position="'bottom-end'">
                            <button class="btn btn-light btn-sm o_agentui_more" t-att-title="'Manage ' + app.name" aria-label="Manage app">
                                <i class="fa fa-ellipsis-h" aria-hidden="true"/>
                            </button>
                            <t t-set-slot="content">
                                <t t-foreach="manageItems" t-as="item" t-key="item.key">
                                    <div t-if="item.key === 'users'" class="dropdown-divider"/>
                                    <DropdownItem onSelected="() => props.onManage(app, item)">
                                        <i t-attf-class="fa {{ item.icon }} me-2 text-muted" aria-hidden="true"/><t t-esc="item.label"/>
                                    </DropdownItem>
                                </t>
                            </t>
                        </Dropdown>
                    </div>
                    <a href="#" class="o_agentui_card d-flex gap-3 align-items-start h-100 text-reset text-decoration-none"
                       t-att-title="app.name" t-on-click.prevent="() => props.onOpen(app)">
                        <img t-if="app.has_icon" t-att-src="app.icon_src" class="o_agentui_icon" alt=""/>
                        <span t-else="" class="o_agentui_icon o_agentui_monogram" t-att-style="tileStyle(app)"
                              aria-hidden="true" t-esc="initials(app)"/>
                        <div class="min-w-0">
                            <div class="o_agentui_name fw-semibold" t-esc="app.name"/>
                            <div t-if="app.description" class="small text-muted o_agentui_desc" t-esc="app.description"/>
                        </div>
                    </a>
                </div>
            </div>
        </section>
    </t>
</templates>
