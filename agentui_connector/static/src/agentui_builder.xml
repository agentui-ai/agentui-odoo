<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agentui_connector.Builder">
        <div class="o_agentui o_agentui_with_bar h-100">
            <div class="o_agentui_topbar">
                <button type="button" class="btn btn-link btn-sm o_agentui_back" t-on-click="goBack">
                    <i class="fa fa-arrow-left me-2" aria-hidden="true"/>AgentUI
                </button>
                <span class="o_agentui_topbar_title text-truncate" t-esc="props.action?.name or 'AgentUI'"/>
            </div>
            <div class="o_agentui_body position-relative">
            <div t-if="state.loading" class="o_agentui_loading" role="status">
                <img src="/agentui_connector/static/description/icon.png" alt="" class="o_agentui_loading_logo"/>
                <div class="spinner-border spinner-border-sm text-secondary" aria-hidden="true"/>
                <span class="text-muted small">Opening AgentUI…</span>
            </div>
            <iframe class="o_agentui_frame" t-att-src="src" title="AgentUI" t-on-load="onLoad"
                    allow="clipboard-write; clipboard-read; microphone; camera"/>
            </div>
        </div>
    </t>
</templates>
