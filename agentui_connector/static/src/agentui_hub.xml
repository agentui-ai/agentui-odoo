<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agentui_connector.Hub">
        <div class="o_agentui_hub h-100 overflow-auto">
            <div class="o_agentui_page container-fluid py-4 py-md-5">
                <div t-if="state.error" class="alert alert-danger d-flex gap-2 align-items-start" role="alert">
                    <i class="fa fa-exclamation-circle mt-1" aria-hidden="true"/>
                    <span class="me-auto" t-esc="state.error"/>
                    <button type="button" class="btn-close" aria-label="Close" t-on-click="() => this.state.error = ''"/>
                </div>
                <div t-if="state.info.connecting" class="alert alert-info d-flex gap-2 align-items-center" role="status">
                    <i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/>
                    <span>Finishing the connection with AgentUI…</span>
                </div>
                <div t-if="state.info.connected and state.info.needs_reconnect" class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="alert">
                    <i class="fa fa-plug" aria-hidden="true"/>
                    <span class="me-auto">AgentUI stopped accepting this connection. Your apps are still here; reconnect to keep them in sync.</span>
                    <button t-if="state.info.is_admin" class="btn btn-warning btn-sm" t-on-click="connect">Reconnect</button>
                    <span t-else="" class="small">Ask an Odoo administrator to reconnect.</span>
                </div>

                <t t-if="!state.info.connected" t-call="agentui_connector.HubWelcome"/>
                <t t-else="">
                    <t t-call="agentui_connector.HubHeader"/>
                    <t t-call="agentui_connector.HubPrompt"/>
                    <AgentUIAppList apps="state.info.apps" onOpen.bind="openApp" onManage="state.info.is_admin ? manageApp.bind(this) : undefined"/>
                </t>
            </div>
        </div>
    </t>

    <t t-name="agentui_connector.HubHeader">
        <div class="d-flex align-items-center gap-3 mb-4">
            <img src="/agentui_connector/static/description/icon.png" class="o_agentui_logo" alt=""/>
            <div class="me-auto min-w-0">
                <h1 class="o_agentui_title mb-0">AgentUI</h1>
                <div class="text-muted small text-truncate">
                    <span class="o_agentui_dot" aria-hidden="true"/>
                    <span>Connected to</span> <b t-esc="state.info.connected_company"/>
                </div>
            </div>
            <Dropdown t-if="state.info.is_admin" position="'bottom-end'">
                <button class="btn btn-light o_agentui_more" t-att-disabled="state.busy" title="Connection settings" aria-label="Connection settings">
                    <i class="fa fa-ellipsis-h fa-lg" aria-hidden="true"/>
                </button>
                <t t-set-slot="content">
                    <div class="dropdown-header small text-muted text-wrap">
                        <span>Signed in to AgentUI as</span><br/><b t-esc="state.info.connected_email"/>
                    </div>
                    <div class="dropdown-divider"/>
                    <DropdownItem onSelected.bind="sync"><i class="fa fa-refresh me-2" aria-hidden="true"/>Sync apps</DropdownItem>
                    <DropdownItem onSelected.bind="disconnect" class="'text-danger'"><i class="fa fa-chain-broken me-2" aria-hidden="true"/>Disconnect</DropdownItem>
                </t>
            </Dropdown>
        </div>
    </t>

    <t t-name="agentui_connector.HubPrompt">
        <section class="o_agentui_hero mb-5">
            <div class="o_agentui_mode mb-3" role="group" aria-label="What to build">
                <button type="button" class="btn o_agentui_mode_btn" t-att-class="{ active: !isAutomation }"
                        t-att-aria-pressed="!isAutomation" t-on-click="() => this.setMode('apps')">
                    <i class="fa fa-th-large me-2" aria-hidden="true"/>Apps / Dashboards
                </button>
                <button type="button" class="btn o_agentui_mode_btn" t-att-class="{ active: isAutomation }"
                        t-att-aria-pressed="isAutomation" t-on-click="() => this.setMode('automations')">
                    <i class="fa fa-bolt me-2" aria-hidden="true"/>Automations
                </button>
            </div>
            <h2 class="o_agentui_hero_title" t-esc="copy.title"/>
            <p class="text-muted mb-3" t-esc="copy.subtitle"/>
            <textarea t-ref="prompt" id="agentui_prompt" class="form-control o_agentui_prompt" rows="3" maxlength="1600"
                      t-att-aria-label="copy.title" t-model="state.prompt" t-att-placeholder="copy.placeholder"/>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                <span class="text-muted small me-1">Try:</span>
                <button t-foreach="ideas" t-as="idea" t-key="idea_index" type="button"
                        class="btn o_agentui_chip" t-on-click="() => this.useIdea(idea)" t-esc="idea.label"/>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-4">
                <button class="btn btn-lg o_agentui_build" t-on-click="build">
                    <i class="fa fa-magic me-2" aria-hidden="true"/>Build it
                </button>
                <button class="btn btn-lg btn-link o_agentui_newtab" t-on-click="buildInNewTab">
                    Open in a new tab <i class="fa fa-external-link ms-1" aria-hidden="true"/>
                </button>
            </div>
            <p class="text-muted small mt-3 mb-0" t-esc="copy.after"/>
        </section>
    </t>

    <t t-name="agentui_connector.HubWelcome">
        <section class="o_agentui_welcome text-center mx-auto">
            <img src="/agentui_connector/static/description/icon.png" class="o_agentui_logo o_agentui_logo_lg mb-4" alt=""/>
            <h1 class="o_agentui_welcome_title">Build apps on your Odoo data</h1>
            <p class="lead text-muted mx-auto">Describe the app you need. AgentUI builds it, and it opens from your Odoo home menu.</p>
            <t t-if="state.info.is_admin">
                <button class="btn btn-lg o_agentui_build mt-2" t-att-disabled="state.info.connecting" t-on-click="connect"><t t-if="state.info.connecting">Connecting…</t><t t-else="">Connect to AgentUI</t></button>
                <p class="text-muted small mt-3 mx-auto o_agentui_narrow">Sign in or create a free AgentUI account, then approve. Odoo creates the API key for you, so there is nothing to copy.</p>
            </t>
            <div t-else="" class="alert alert-light border d-inline-block mt-2">
                <i class="fa fa-info-circle me-2" aria-hidden="true"/>Ask an Odoo administrator to open this menu and press Connect to AgentUI.
            </div>
            <div class="row g-3 mt-4 text-start">
                <div t-foreach="steps" t-as="step" t-key="step_index" class="col-12 col-md-4">
                    <div class="o_agentui_step h-100">
                        <span class="o_agentui_step_num" t-esc="step_index + 1"/>
                        <div class="fw-semibold mt-2" t-esc="step.title"/>
                        <div class="small text-muted" t-esc="step.text"/>
                    </div>
                </div>
            </div>
        </section>
    </t>
</templates>
