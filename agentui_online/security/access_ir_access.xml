<?xml version="1.0" encoding="utf-8"?>
<!--
  Odoo 20+ (ir.access replaced ir.model.access + ir.rule). Same rules as
  access.xml, which the build script uses for Odoo 18 and 19:
  - x_agentui_app: employees read, administrators manage (Sync).
  - x_agentui_settings: employees read, administrators update.
  - x_agentui_secret: administrators only (the connector token).
  - x_agentui_signin: employees create and read only their own proofs;
    administrators (the API key AgentUI uses) all of them. Permissions with a
    group are OR-ed, so the admin line needs no domain.
-->
<odoo>
    <record id="access_x_agentui_app_user" model="ir.access">
        <field name="name">x_agentui_app employees read</field>
        <field name="model_id" ref="model_x_agentui_app"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="operation">r</field>
    </record>
    <record id="access_x_agentui_app_admin" model="ir.access">
        <field name="name">x_agentui_app administrators</field>
        <field name="model_id" ref="model_x_agentui_app"/>
        <field name="group_id" ref="base.group_system"/>
        <field name="operation">crud</field>
    </record>
    <record id="access_x_agentui_settings_user" model="ir.access">
        <field name="name">x_agentui_settings employees read</field>
        <field name="model_id" ref="model_x_agentui_settings"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="operation">r</field>
    </record>
    <record id="access_x_agentui_settings_admin" model="ir.access">
        <field name="name">x_agentui_settings administrators</field>
        <field name="model_id" ref="model_x_agentui_settings"/>
        <field name="group_id" ref="base.group_system"/>
        <field name="operation">ru</field>
    </record>
    <record id="access_x_agentui_secret_admin" model="ir.access">
        <field name="name">x_agentui_secret administrators only</field>
        <field name="model_id" ref="model_x_agentui_secret"/>
        <field name="group_id" ref="base.group_system"/>
        <field name="operation">ru</field>
    </record>
    <record id="access_x_agentui_signin_user" model="ir.access">
        <field name="name">x_agentui_signin employees create and read their own</field>
        <field name="model_id" ref="model_x_agentui_signin"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="operation">cr</field>
        <field name="domain">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="access_x_agentui_signin_admin" model="ir.access">
        <field name="name">x_agentui_signin administrators</field>
        <field name="model_id" ref="model_x_agentui_signin"/>
        <field name="group_id" ref="base.group_system"/>
        <field name="operation">crud</field>
    </record>
</odoo>
