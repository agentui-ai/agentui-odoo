<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agentui_online.PasswordDialog" owl="1">
        <Dialog title="this.tr('Confirm your password')" size="'md'">
            <p t-out="this.tr('Confirm your Odoo password to create the API key for AgentUI.')" />
            <input id="agentui_password" type="password" class="form-control" autocomplete="current-password"
                   t-att-aria-label="this.tr('Odoo password')" t-att-placeholder="this.tr('Odoo password')"
                   t-att-disabled="this.state.busy" t-on-keydown="(ev) => this.onKeydown(ev)" />
            <div t-if="this.state.error" class="text-danger small mt-2" role="alert" t-out="this.state.error" />
            <p class="text-muted small mt-3 mb-0" t-out="this.tr('You sign in to Odoo with Google or Odoo.com? Use your odoo.com account password. No password yet: open odoo.com, choose Reset password, then come back.')" />
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="this.state.busy" t-on-click="(ev) => this.confirm(ev)" t-out="this.tr('Confirm')" />
                <button class="btn btn-secondary" t-att-disabled="this.state.busy" t-on-click="(ev) => this.cancel(ev)" t-out="this.tr('Cancel')" />
            </t>
        </Dialog>
    </t>
</templates>
