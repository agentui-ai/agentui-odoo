<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agentui_online.Builder" owl="1">
        <div class="o_agentui o_agentui_with_bar h-100">
            <div class="o_agentui_topbar">
                <button type="button" class="btn btn-link btn-sm o_agentui_back" t-on-click="(ev) => this.goBack(ev)">
                    <i class="fa fa-arrow-left me-2" aria-hidden="true" />AgentUI
                </button>
                <span class="o_agentui_topbar_title text-truncate" t-out="this.props.action?.name or 'AgentUI'" />
            </div>
            <div class="o_agentui_body position-relative">
                <div t-if="this.state.loading" class="o_agentui_loading" role="status">
                    <img t-att-src="this.iconSrc" alt="" class="o_agentui_loading_logo" />
                    <div class="spinner-border spinner-border-sm text-secondary" aria-hidden="true" />
                    <span class="text-muted small" t-out="this.tr('Opening AgentUI…')" />
                </div>
                <iframe class="o_agentui_frame" t-att-src="this.src" title="AgentUI" t-on-load="(ev) => this.onLoad(ev)"
                        allow="clipboard-write; clipboard-read; microphone; camera" />
            </div>
        </div>
    </t>
</templates>
